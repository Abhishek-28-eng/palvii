# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=palvii_db
DB_USER=root
DB_PASSWORD=root

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Customer-facing WhatsApp (for order/contact links)
PALVII_WHATSAPP_NUMBER=919XXXXXXXXX

# Owner WhatsApp Notifications (via CallMeBot — free)
# Setup: Send "I allow callmebot to send me messages" to +34 644 59 72 87 on WhatsApp
# You'll receive your API key. Then fill these in:
OWNER_WHATSAPP=91XXXXXXXXXX        # your personal WhatsApp number with country code, no +
CALLMEBOT_API_KEY=your_api_key    # received from CallMeBot after one-time setup

# Payment Gateway (Razorpay - for future use)
PAYMENT_KEY=your_razorpay_key
PAYMENT_SECRET=your_razorpay_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
